{
	"name": "PL_SQLtoADLS_IncrementalIngestion",
	"properties": {
		"activities": [
			{
				"name": "01-tableList-lookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "csv",
						"type": "DatasetReference",
						"parameters": {
							"file": {
								"value": "@pipeline().parameters.p_pl_file",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "01-tableList-lookup",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('01-tableList-lookup').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy data1",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select * from @{item().schema}.@{item().table} where @{item().cdc_col} >= '@{if(empty(item().from_date),if(empty(item().cdc_latest_value),item().cdc_init_value,item().cdc_latest_value),item().from_date)} ' && @{item().cdc_col} <= ' @{if(empty(item().to_date),utcNow(),item().to_date)}'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_RawSpotifyData",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "DS_adls_parquet",
									"type": "DatasetReference",
									"parameters": {
										"p_ds_container": {
											"value": "@pipeline().parameters.p_pl_sink_container",
											"type": "Expression"
										},
										"p_ds_folder": {
											"value": "@item().table",
											"type": "Expression"
										},
										"p_ds_file": {
											"value": "@concat(item().table,'_',utcNow())",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "latest",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "maxScript",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "cdc_latest_value",
								"value": ""
							}
						},
						{
							"name": "lastrun",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Copy data1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "last_run",
								"value": {
									"value": "utcNow()",
									"type": "Expression"
								}
							}
						},
						{
							"name": "maxScript",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "ls_SQLDB_spotify_source",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "select @{max(item().updated_at)} from @{item().schema}.@{item().table}",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Data flow1",
							"type": "ExecuteDataFlow",
							"dependsOn": [
								{
									"activity": "latest",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "dataflow1",
									"type": "DataFlowReference",
									"parameters": {
										"cdc": {
											"value": "'@{item().cdc_col}'",
											"type": "Expression"
										}
									}
								},
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_pl_container": {
				"type": "string",
				"defaultValue": "config"
			},
			"p_pl_file": {
				"type": "string",
				"defaultValue": "tableNames.csv"
			},
			"p_pl_sink_container": {
				"type": "string",
				"defaultValue": "bronze"
			}
		},
		"variables": {
			"current": {
				"type": "String"
			},
			"cdc_latest_value": {
				"type": "String"
			},
			"last_run": {
				"type": "String"
			}
		},
		"annotations": []
	}
}