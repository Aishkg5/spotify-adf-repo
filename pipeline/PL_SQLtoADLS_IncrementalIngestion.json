{
	"name": "PL_SQLtoADLS_IncrementalIngestion",
	"properties": {
		"activities": [
			{
				"name": "01-tableList-lookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_tableList_json",
						"type": "DatasetReference",
						"parameters": {
							"p_ds_container": {
								"value": "@pipeline().parameters.p_pl_container",
								"type": "Expression"
							},
							"p_ds_file": {
								"value": "@pipeline().parameters.p_pl_file",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			}
		],
		"parameters": {
			"p_pl_container": {
				"type": "string",
				"defaultValue": "config"
			},
			"p_pl_file": {
				"type": "string",
				"defaultValue": "tableNames.json"
			}
		},
		"variables": {
			"current": {
				"type": "String"
			}
		},
		"annotations": []
	}
}