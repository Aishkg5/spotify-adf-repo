{
	"name": "json_to_csv",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".csv"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "DS_tableList_json",
						"type": "DatasetReference",
						"parameters": {
							"p_ds_container": {
								"value": "@pipeline().parameters.p_container",
								"type": "Expression"
							},
							"p_ds_file": {
								"value": "@pipeline().parameters.p_file",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "csv",
						"type": "DatasetReference",
						"parameters": {
							"file": {
								"value": "@replace(pipeline().parameters.p_file,'json','csv')",
								"type": "Expression"
							},
							"container": {
								"value": "@pipeline().parameters.p_container",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"p_container": {
				"type": "string",
				"defaultValue": "config"
			},
			"p_file": {
				"type": "string",
				"defaultValue": "tableNames.json"
			}
		},
		"annotations": []
	}
}