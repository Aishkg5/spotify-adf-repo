{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "ls_ADLS_sink",
						"type": "LinkedServiceReference"
					},
					"name": "source1"
				},
				{
					"linkedService": {
						"referenceName": "ls_SQLDB_spotify_source",
						"type": "LinkedServiceReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ls_ADLS_sink",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     cdc as string (''),",
				"     schema as string,",
				"     table as string",
				"}",
				"source(output(",
				"          schema as string,",
				"          table as string,",
				"          cdc_col as string,",
				"          cdc_init_value as timestamp,",
				"          cdc_latest_value as string,",
				"          from_date as string,",
				"          to_date as string,",
				"          last_run as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'config',",
				"     fileName: 'tableNames.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> source1",
				"source(output(",
				"          user_id as integer,",
				"          user_name as string,",
				"          country as string,",
				"          subscription_type as string,",
				"          start_date as date,",
				"          end_date as date,",
				"          updated_at as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: ($schema),",
				"     tableName: ($table),",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     partitionBy('hash', 1)) ~> source2",
				"join1 derive(last_run = currentUTC(),",
				"          cdc_latest_value = updated_at) ~> derivedColumn1",
				"source2 aggregate(updated_at = max(updated_at)) ~> aggregate1",
				"select1 alterRow(updateIf(true()),",
				"     partitionBy('hash', 1)) ~> alterRow1",
				"source1, aggregate1 join(true(),",
				"     joinType:'cross',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"derivedColumn1 select(mapColumn(",
				"          schema,",
				"          table,",
				"          cdc_col,",
				"          cdc_init_value,",
				"          cdc_latest_value,",
				"          from_date,",
				"          to_date,",
				"          last_run",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delimited',",
				"     fileSystem: 'config',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}